# Copy to .env and fill in. Never commit .env.

# Qloo: "mock" uses synthetic fixtures (DEMO DATA, not from Qloo); "live" calls the qloo CLI.
QLOO_MODE=mock
# Read by the qloo CLI from the environment. Never passed as a flag.
QLOO_API_KEY=your-qloo-api-key-here
# Hackathon keys use the hackathon endpoint. The CLI only sends the key to a custom URL
# that is also listed, exactly, in QLOO_TRUSTED_BASE_URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Optional LLM (any OpenAI-compatible endpoint). The app works with LLM_MODE=off.
LLM_MODE=off
LLM_API_KEY=api-key-for-your-openai-compatible-endpoint
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your-model-name

# Optional overrides
# QLOO_BIN=qloo
# CACHE_DIR=cache
# PORT=8000
